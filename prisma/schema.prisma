generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. ORGANIZATION BOUNDARY
// ==========================================

model Organization {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique // e.g. "NFVS-CORP"
  legalName   String?
  logo        String?
  favicon     String?
  primaryColor String?     @default("#2563eb")
  secondaryColor String?   @default("#1e40af")
  industry    String?      @default("Technology & Enterprise Services")
  website     String?
  email       String?
  phone       String?
  address     String?
  currency    String       @default("USD")
  timezone    String       @default("UTC")
  dateFormat  String       @default("YYYY-MM-DD")
  fiscalYear  String       @default("JAN-DEC")
  status      String       @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  departments      Department[]
  teams            Team[]
  employees        Employee[]
  memberships      UserCompanyMembership[]
  companySettings  CompanySetting[]
  roles            Role[]
  auditLogs        AuditLog[]
  workDayConfigs   WorkDayConfig[]
  holidays         Holiday[]
  leavePolicies    LeavePolicy[]
  hrPolicies       HrPolicy[]
  complianceItems  ComplianceRecord[]
  preOnboardingSubmissions PreOnboardingSubmission[]
  salaryComponents SalaryComponent[]
  salaryStructures SalaryStructure[]
  payrollPeriods   PayrollPeriod[]
  tasks            Task[]
  calendarEvents   CalendarEvent[]
  notifications    Notification[]
  clients          Client[]
  leads            Lead[]
  opportunities    Opportunity[]
  crmActivities    CrmActivity[]
  invoices         Invoice[]
  payments         Payment[]
  expenses         Expense[]
  financialTransactions FinancialTransaction[]

  // Products & Inventory Relations
  productCategories    ProductCategory[]
  products             Product[]
  services             Service[]
  warehouses           Warehouse[]
  inventoryItems       InventoryItem[]
  stockMovements       StockMovement[]
  inventoryAdjustments InventoryAdjustment[]

  // Vendors & Procurement Relations
  vendors              Vendor[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]

  // Operations Relations
  operations           Operation[]
  operationIssues      OperationIssue[]
  approvals            ApprovalRequest[]

  // Legal & Compliance Relations
  legalContracts       LegalContract[]
  legalCases           LegalCase[]
  legalCompliance      LegalCompliance[]
  legalContacts        LegalContact[]
  legalDeadlines       LegalDeadline[]
  legalDocuments       LegalDocument[]
  legalRisks           LegalRisk[]
  legalActivities      LegalActivity[]
  employeeRequests     EmployeeRequest[]
  onDutyAssignments    OnDutyAssignment[]
  workflows            Workflow[]
  workflowExecutions   WorkflowExecution[]
  conversations        Conversation[]
  announcements        Announcement[]
  aiConversations      AIConversation[]
  aiConfiguration      AIConfiguration?
  aiUsageLogs          AIUsageLog[]

  // Dedicated Accounts & Double-Entry Accounting
  accounts             Account[]
  journalEntries       JournalEntry[]
  bankAccounts         BankAccount[]
  estimates            Estimate[]
  salesOrders          SalesOrder[]
  creditNotes          CreditNote[]
  vendorCredits        VendorCredit[]
  taxRates             TaxRate[]
  accountingSetting    AccountingSetting?

  @@index([code])
}

// ==========================================
// 2. DEPARTMENT STRUCTURE
// ==========================================

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String       // e.g. "ENG", "HR", "FIN", "EXEC"
  description    String?
  managerId      String?      // Reference to an Employee who leads this department
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  teams          Team[]
  employees      Employee[]
  holidays       Holiday[]
  hrPolicies     HrPolicy[]
  complianceItems ComplianceRecord[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  expenses       Expense[]
  financialTransactions FinancialTransaction[]
  purchaseRequests PurchaseRequest[]
  operations     Operation[]
  legalContracts LegalContract[]
  legalCompliance LegalCompliance[]
  employeeRequests EmployeeRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// ==========================================
// 2B. TEAM STRUCTURE (Hierarchical Teams)
// ==========================================

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  code           String       // e.g. "FE-ENG", "BE-ENG", "QA-AUTOMATION"
  description    String?
  leaderId       String?      // Reference to Team Lead Employee ID
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees      Employee[]

  @@unique([departmentId, code])
  @@index([organizationId])
  @@index([departmentId])
}

// ==========================================
// 3. ROLE & HIERARCHY
// ==========================================

model Role {
  id             String           @id @default(cuid())
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String           @unique // SUPER_ADMIN, ADMIN, CHAIRPERSON, CEO, CTO, CIO, CMO, CFO, COO, HR, DEPARTMENT_HEAD, MANAGER, TEAM_LEAD, EMPLOYEE
  name           String
  level          Int              // 100 down to 10
  description    String?
  dataScope      String           @default("SELF") // SELF, TEAM, DEPARTMENT, BUSINESS_UNIT, COMPANY, GLOBAL
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now())

  users           User[]
  rolePermissions RolePermission[]
  memberships     UserCompanyMembership[]

  @@index([code])
  @@index([organizationId])
}

// ==========================================
// 4. PERMISSIONS (module.resource.action)
// ==========================================

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // e.g. "employees.employee.read", "hr.leave.approve"
  module      String           // e.g. "employees", "hr", "finance", "crm", "operations", "audit"
  resource    String           // e.g. "employee", "leave", "attendance", "policy"
  action      String           // e.g. "read", "create", "update", "delete", "approve"
  description String?
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
}

// ==========================================
// 5. USER (System Access & Credentials)
// ==========================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employee            Employee?      // Optional 1:1 relation to Employee
  auditLogs           AuditLog[]     @relation("UserAuditLogs")
  notifications       Notification[]
  dashboardPreference DashboardPreference?
  aiConversations     AIConversation[]
  aiUsageLogs         AIUsageLog[]
  memberships         UserCompanyMembership[]
  userSettings        UserSetting[]

  @@index([email])
  @@index([roleId])
}

// ==========================================
// 6. EMPLOYEE (Corporate Personnel Master)
// ==========================================

model Employee {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId     String?
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId           String?
  team             Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  userId           String?      @unique // Optional link to User login account
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  managerId        String?
  manager          Employee?    @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports    Employee[]   @relation("EmployeeHierarchy")

  employeeNumber   String       @unique // e.g. "NFVS-0001"
  firstName        String
  lastName         String
  email            String       @unique
  phone            String?
  avatarUrl        String?
  designation      String       // e.g. "Chief Technology Officer", "Senior Staff Architect"
  employmentType   String       @default("FULL_TIME") // FULL_TIME, CONTRACT, PART_TIME, INTERN
  employmentStatus String       @default("ACTIVE")    // ACTIVE, PROBATION, ON_LEAVE, TERMINATED
  workMode         String       @default("ON_SITE")   // ON_SITE, REMOTE, HYBRID
  location         String       @default("Headquarters (New York)")
  emergencyContact String?
  hireDate         DateTime
  baseSalary       Float?
  currency         String       @default("USD")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Onboarding & Profile Verification Lifecycle
  onboardingStatus String       @default("COMPLETED") // PENDING_PROFILE, PENDING_VERIFICATION, PENDING_APPROVAL, COMPLETED, REJECTED
  profileCompletion Int         @default(100)         // 0-100 percentage
  approvalNotes    String?
  approvedAt       DateTime?
  approvedBy       String?
  profile          EmployeeProfile?
  documents        EmployeeDocument[]

  // HR Relations
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  approvedLeaves     LeaveRequest[]        @relation("ApprovedByEmployee")
  attendanceLogs     AttendanceRecord[]
  submittedRequests  EmployeeRequest[]     @relation("EmployeeRequestsSubmitted")
  approvedRequests   EmployeeRequest[]     @relation("EmployeeRequestsApproved")
  onDutyAssignments  OnDutyAssignment[]    @relation("OnDutyEmployee")

  // Payroll Relations
  salaryStructures EmployeeSalaryStructure[]
  payrollEntries   PayrollEntry[]

  // Task & Activity Relations
  createdTasks     Task[]               @relation("TaskCreator")
  assignedTasks    Task[]               @relation("TaskAssignee")
  taskComments     TaskComment[]
  createdEvents    CalendarEvent[]      @relation("CalendarEventCreator")

  // CRM Relations
  ownedClients       Client[]             @relation("ClientOwner")
  ownedLeads         Lead[]               @relation("LeadOwner")
  ownedOpportunities Opportunity[]        @relation("OpportunityOwner")
  crmActivities      CrmActivity[]        @relation("ActivityPerformer")

  // Finance Relations
  createdInvoices      Invoice[]              @relation("InvoiceCreator")
  approvedInvoices     Invoice[]              @relation("InvoiceApprover")
  recordedPayments     Payment[]              @relation("PaymentRecorder")
  reversedPayments     Payment[]              @relation("PaymentReverser")
  submittedExpenses    Expense[]              @relation("ExpenseEmployee")
  approvedExpenses     Expense[]              @relation("ExpenseApprover")
  createdTransactions  FinancialTransaction[] @relation("TransactionCreator")

  // Products & Inventory Relations
  createdProducts          Product[]              @relation("ProductCreator")
  createdServices          Service[]              @relation("ServiceCreator")
  managedWarehouses        Warehouse[]            @relation("WarehouseManager")
  performedStockMovements  StockMovement[]        @relation("StockMovementPerformer")
  requestedAdjustments     InventoryAdjustment[]  @relation("AdjustmentRequester")
  approvedAdjustments      InventoryAdjustment[]  @relation("AdjustmentApprover")

  // Vendors & Procurement Relations
  createdVendors            Vendor[]               @relation("VendorCreator")
  requestedPurchaseRequests  PurchaseRequest[]      @relation("PurchaseRequester")
  reviewedPurchaseRequests   PurchaseRequest[]      @relation("PurchaseRequestReviewer")
  approvedPurchaseRequests   PurchaseRequest[]      @relation("PurchaseRequestApprover")
  createdPurchaseOrders     PurchaseOrder[]        @relation("PurchaseOrderCreator")
  approvedPurchaseOrders    PurchaseOrder[]        @relation("PurchaseOrderApprover")
  receivedGoodsReceipts     GoodsReceipt[]         @relation("GoodsReceiver")
  finalizedGoodsReceipts    GoodsReceipt[]         @relation("GoodsReceiptFinalizer")

  // Operations Relations
  ownedOperations           Operation[]            @relation("OperationOwner")
  operationAssignments      OperationEmployee[]    @relation("OperationAssignedEmployee")
  reportedIssues            OperationIssue[]       @relation("IssueReporter")
  assignedIssues            OperationIssue[]       @relation("IssueAssignee")
  issueComments             OperationIssueComment[] @relation("IssueCommentAuthor")
  requestedApprovals        ApprovalRequest[]      @relation("ApprovalRequester")
  decidedApprovals          ApprovalRequest[]      @relation("ApprovalApprover")
  uploadedDocuments         OperationDocument[]    @relation("DocumentUploader")
  operationActivities       OperationActivity[]    @relation("OperationActivityPerformer")

  // Legal Relations
  legalContractsAsLegalOwner     LegalContract[]          @relation("LegalContractLegalOwner")
  legalContractsAsBusinessOwner  LegalContract[]          @relation("LegalContractBusinessOwner")
  legalCasesAsInternalOwner      LegalCase[]              @relation("LegalCaseInternalOwner")
  complianceRequirements         LegalCompliance[]        @relation("LegalComplianceOwner")
  legalDeadlines                 LegalDeadline[]          @relation("LegalDeadlineOwner")
  legalRisks                     LegalRisk[]              @relation("LegalRiskOwner")
  uploadedLegalDocuments         LegalDocument[]          @relation("LegalDocumentUploader")
  uploadedLegalVersions          LegalDocumentVersion[]   @relation("LegalDocumentVersionUploader")
  submittedComplianceEvidence   ComplianceEvidence[]     @relation("ComplianceEvidenceSubmitter")
  verifiedComplianceEvidence    ComplianceEvidence[]     @relation("ComplianceEvidenceVerifier")
  legalActivities                LegalActivity[]          @relation("LegalActivityPerformer")
  initiatedRenewals              LegalRenewal[]           @relation("RenewalInitiator")
  partyToContracts               LegalContract[]          @relation("LegalContractEmployeeParty")
  partyToLegalCases              LegalCase[]              @relation("LegalCaseEmployeeParty")
  createdWorkflows               Workflow[]               @relation("WorkflowCreator")
  conversationParticipants       ConversationParticipant[]
  sentMessages                   Message[]                @relation("MessageSender")
  createdConversations           Conversation[]           @relation("ConversationCreator")
  authoredAnnouncements          Announcement[]           @relation("AnnouncementAuthor")
  readAnnouncements              AnnouncementRead[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([teamId])
  @@index([managerId])
  @@index([organizationId, employmentStatus])
  @@index([organizationId, departmentId])
  @@index([organizationId, designation])
  @@index([onboardingStatus])
  @@index([lastName, firstName])
}
 
// ==========================================
// 6B. EMPLOYEE PROFILE & DOSSIER (Complete Profile Workflow)
// ==========================================

model EmployeeProfile {
  id                      String       @id @default(cuid())
  employeeId              String       @unique
  employee                Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  // 1. Personal Information
  dateOfBirth             DateTime?
  gender                  String?      // MALE, FEMALE, NON_BINARY, OTHER
  maritalStatus           String?      // SINGLE, MARRIED, DIVORCED, WIDOWED
  bloodGroup              String?      // A+, A-, B+, B-, AB+, AB-, O+, O-
  nationality             String?      @default("Indian")
  fatherOrSpouseName      String?
  bio                     String?

  // 3. Contact & Address
  currentAddress          String?
  permanentAddress        String?
  personalEmail           String?
  alternatePhone          String?
  city                    String?
  state                   String?
  postalCode              String?
  country                 String?      @default("India")

  // 4. Government IDs
  panNumber               String?
  aadhaarNumber           String?
  passportNumber          String?
  passportExpiry          DateTime?
  ssnOrNationalId         String?
  taxId                   String?

  // 5. Bank / Payroll
  bankName                String?
  accountHolderName       String?
  accountNumber           String?
  ifscOrRoutingCode       String?
  branchName              String?
  accountType             String?      @default("SAVINGS") // SAVINGS, CURRENT, SALARY
  upiId                   String?

  // 6. Emergency Contact
  primaryContactName      String?
  primaryContactRelation  String?
  primaryContactPhone     String?
  secondaryContactName    String?
  secondaryContactRelation String?
  secondaryContactPhone   String?

  // 7. Education
  highestDegree           String?
  institution             String?
  fieldOfStudy            String?
  graduationYear          Int?
  gradeOrGpa              String?
  certifications          String?

  // 8. Professional Details
  previousEmployer        String?
  previousDesignation     String?
  totalExperienceYears    Float?       @default(0)
  skills                  String?      // comma-separated or json array
  linkedinUrl             String?
  portfolioUrl            String?

  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([employeeId])
}

model EmployeeDocument {
  id                 String       @id @default(cuid())
  employeeId         String
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  type               String       // RESUME, GOVT_ID, AADHAAR, PAN, PASSPORT, ADDRESS_PROOF, EDUCATION_CERTIFICATE, EXPERIENCE_LETTER, OFFER_LETTER, OTHER
  title              String       // Display title e.g. "Aadhaar Card Front & Back"
  fileName           String
  fileUrl            String       // Storage path, data URL, or doc link
  fileSize           Int?         // in bytes
  mimeType           String?
  verificationStatus String       @default("PENDING") // PENDING, VERIFIED, REJECTED
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedBy         String?      // Verifier name / ID
  uploadedAt         DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([employeeId])
  @@index([verificationStatus])
  @@index([employeeId, verificationStatus])
}

// ==========================================
// 7. WORK DAYS & WEEKENDS CONFIGURATION
// ==========================================

model WorkDayConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dayOfWeek      Int          // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  dayName        String       // e.g. "Monday", "Sunday"
  isWorkingDay   Boolean      @default(true)
  workStartTime  String       @default("09:00")
  workEndTime    String       @default("18:00")
  expectedHours  Float        @default(8.0)
  isHalfDay      Boolean      @default(false)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, dayOfWeek])
  @@index([organizationId])
}

// ==========================================
// 8. HOLIDAYS MANAGEMENT
// ==========================================

model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?      // Null = Organization-wide; Set = Department-specific
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name           String       // e.g. "New Year's Day", "Thanksgiving"
  date           DateTime     // Date of holiday
  description    String?
  isRecurring    Boolean      @default(false)
  year           Int          @default(2026)
  createdAt      DateTime     @default(now())

  @@index([organizationId, year])
  @@index([date])
}

// ==========================================
// 9. LEAVE POLICY & BALANCES
// ==========================================

model LeavePolicy {
  id                   String         @id @default(cuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                 String         // CL, EL, ML, LWP, C_OFF, HDW
  name                 String         // "Casual Leave", "Emergency Leave", etc.
  annualAllowance      Float          // e.g. 12 for CL, 3 for EL, 3 for ML, 0 for LWP
  monthlyLimit         Float?         // e.g. 2 for CL (Max 2 CL per month)
  carryForward         Boolean        @default(false)
  requiresApproval     Boolean        @default(true)
  requiresDocumentation Boolean       @default(false) // e.g. doctor note for medical leave
  description          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model LeaveBalance {
  id             String      @id @default(cuid())
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicyId  String
  leavePolicy    LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  year           Int         @default(2026)
  allocated      Float       // Initial annual allocation
  used           Float       @default(0)
  pending        Float       @default(0)
  remaining      Float       // allocated - used - pending
  updatedAt      DateTime    @updatedAt

  @@unique([employeeId, leavePolicyId, year])
  @@index([employeeId])
  @@index([leavePolicyId])
}

// ==========================================
// 10. LEAVE WORKFLOW & REQUESTS
// ==========================================

model LeaveRequest {
  id             String            @id @default(cuid())
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicyId  String
  leavePolicy    LeavePolicy       @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  daysCount      Float             // Business working days (excluding weekends & holidays)
  reason         String
  status         String            @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedById   String?
  approvedBy     Employee?         @relation("ApprovedByEmployee", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalNotes  String?
  rejectionReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  attendanceLogs AttendanceRecord[]

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

// ==========================================
// 11. ATTENDANCE TRACKING
// ==========================================

model AttendanceRecord {
  id             String        @id @default(cuid())
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime      // Day normalized to midnight YYYY-MM-DD
  status         String        @default("PRESENT") // PRESENT, ABSENT, ON_LEAVE, HALF_DAY, HOLIDAY, WEEKEND
  checkInTime    DateTime?
  checkOutTime   DateTime?
  workMode       String        @default("ON_SITE") // ON_SITE, REMOTE, HYBRID
  remarks        String?
  leaveRequestId String?
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

// ==========================================
// 12. HR POLICIES REPOSITORY
// ==========================================

model HrPolicy {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?       // Null = General company policy; Set = Department specific
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title          String        // e.g. "Attendance & Work Schedule Policy"
  category       String        @default("GENERAL") // GENERAL, WORKPLACE, CONDUCT, LEAVE_ATTENDANCE, BENEFITS
  content        String        // Policy text/guidelines
  effectiveDate  DateTime
  version        String        @default("1.0")
  isMandatory    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([category])
}

// ==========================================
// 13. COMPLIANCE RECORDS FOUNDATION
// ==========================================

model ComplianceRecord {
  id                      String        @id @default(cuid())
  organizationId          String
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsibleDepartmentId String?
  responsibleDepartment   Department?   @relation(fields: [responsibleDepartmentId], references: [id], onDelete: SetNull)
  item                    String        // Compliance requirement / filing
  dueDate                 DateTime
  status                  String        @default("PENDING") // PENDING, COMPLIANT, OVERDUE, UNDER_REVIEW
  documentUrl             String?
  reminderDate            DateTime?
  notes                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
}

// ==========================================
// 14. AUDIT LOGGING (Mutations & Security)
// ==========================================

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User?         @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action         String        // e.g. "LEAVE_APPROVED", "ATTENDANCE_CHECK_IN", "USER_CREATED", "COMPANY_SWITCH"
  entity         String        // e.g. "LeaveRequest", "AttendanceRecord", "Company", "User"
  entityId       String?
  previousValue  String?       // JSON previous state
  newValue       String?       // JSON new state
  metadata       String?       // JSON context (IP, route, reason)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([action])
  @@index([entity])
  @@index([actorId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

// ==========================================
// 14B. MULTI-TENANT MEMBERSHIP & SETTINGS
// ==========================================

model UserCompanyMembership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String?
  role           Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isPrimary      Boolean      @default(false)
  status         String       @default("ACTIVE") // ACTIVE, SUSPENDED, INVITED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
}

model CompanySetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       String       @default("GENERAL") // BRANDING, SECURITY, WORKFLOW, NOTIFICATIONS, INTEGRATIONS
  key            String
  value          String       // JSON or string config
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model UserSetting {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  value          String       // JSON or string config
  updatedAt      DateTime     @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// ==========================================
// 15. SYSTEM SETTINGS
// ==========================================

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ==========================================
// 16. SALARY COMPONENT MASTER
// ==========================================

model SalaryComponent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String       // e.g. "BASIC", "HRA", "TA", "DA", "SPECIAL", "PF", "TAX", "BONUS"
  name           String       // e.g. "Basic Salary", "House Rent Allowance"
  type           String       // "EARNING", "DEDUCTION", "REIMBURSEMENT"
  calcType       String       // "FIXED", "PERCENTAGE_OF_BASIC", "PERCENTAGE_OF_GROSS"
  defaultValue   Float        @default(0.0)
  isTaxable      Boolean      @default(true)
  isStatutory    Boolean      @default(false)
  isMandatory    Boolean      @default(false)
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  structureItems SalaryStructureItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// ==========================================
// 17. SALARY STRUCTURE TEMPLATES
// ==========================================

model SalaryStructure {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       // e.g. "Executive Leadership Structure"
  description    String?
  currency       String       @default("USD")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items          SalaryStructureItem[]
  assignments    EmployeeSalaryStructure[]

  @@index([organizationId])
}

model SalaryStructureItem {
  id                String          @id @default(cuid())
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  componentId       String
  component         SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  calcType          String          // "FIXED", "PERCENTAGE_OF_BASIC", "PERCENTAGE_OF_GROSS"
  value             Float           // percentage or fixed amount
  order             Int             @default(0)

  @@unique([salaryStructureId, componentId])
  @@index([salaryStructureId])
}

// ==========================================
// 18. EMPLOYEE SALARY ASSIGNMENTS
// ==========================================

model EmployeeSalaryStructure {
  id                String          @id @default(cuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  baseSalary        Float           // Monthly base salary
  paymentMethod     String          @default("BANK_TRANSFER")
  bankName          String?
  bankAccountMask   String?         // Masked e.g. "•••• •••• 4092"
  taxIdNumber       String?         // PAN / SSN / Tax Registration ID
  effectiveFrom     DateTime
  isActive          Boolean         @default(true)
  customAdjustments String?         // JSON override if any
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([employeeId])
  @@index([salaryStructureId])
}

// ==========================================
// 19. PAYROLL PERIOD & LIFECYCLE
// ==========================================

model PayrollPeriod {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code            String         // e.g. "2026-09"
  name            String         // e.g. "September 2026 Payroll Run"
  year            Int
  month           Int            // 1-12
  startDate       DateTime
  endDate         DateTime
  paymentDate     DateTime?
  status          String         @default("DRAFT") // DRAFT, CALCULATED, REVIEWED, APPROVED, PROCESSED
  totalGross      Float          @default(0.0)
  totalDeductions Float          @default(0.0)
  totalNet        Float          @default(0.0)
  employeeCount   Int            @default(0)
  approvedById    String?
  processedAt     DateTime?
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  entries         PayrollEntry[]
  financialTransactions FinancialTransaction[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
}

// ==========================================
// 20. PAYROLL ENTRY / IMMUTABLE PAYSLIP
// ==========================================

model PayrollEntry {
  id                  String        @id @default(cuid())
  payrollPeriodId     String
  payrollPeriod       PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  totalPeriodDays     Int           @default(30)
  workingDays         Int           @default(22)
  presentDays         Float         @default(22.0)
  paidLeaveDays       Float         @default(0.0)
  unpaidLeaveDays     Float         @default(0.0)
  
  baseSalary          Float
  grossSalary         Float
  totalDeductions     Float
  netSalary           Float
  
  earningsBreakdown   String        // JSON array [{ code, name, amount, type, calcType }]
  deductionsBreakdown String        // JSON array [{ code, name, amount, type, calcType }]
  
  status              String        @default("DRAFT") // DRAFT, CALCULATED, REVIEWED, APPROVED, PAID
  paymentMethod       String        @default("BANK_TRANSFER")
  paymentReference    String?
  paymentDate         DateTime?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([payrollPeriodId, employeeId])
  @@index([payrollPeriodId])
  @@index([employeeId])
  @@index([status])
}

// ==========================================
// 21. TASKS & ASSIGNMENTS
// ==========================================

model Task {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  
  title             String
  description       String?
  priority          String        @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status            String        @default("TODO")   // TODO, IN_PROGRESS, BLOCKED, COMPLETED, CANCELLED
  
  creatorId         String
  creator           Employee      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assigneeId        String?
  assignee          Employee?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  dueDate           DateTime?
  completedAt       DateTime?
  
  relatedEmployeeId String?
  relatedClientId   String?
  client            Client?       @relation(fields: [relatedClientId], references: [id], onDelete: SetNull)
  relatedProjectId  String?
  attachments       String?       // JSON array of { name, url, size }

  // Procurement Task Relations
  relatedVendorId          String?
  vendor                   Vendor?           @relation(fields: [relatedVendorId], references: [id], onDelete: SetNull)
  relatedPurchaseRequestId String?
  purchaseRequest          PurchaseRequest?  @relation(fields: [relatedPurchaseRequestId], references: [id], onDelete: SetNull)
  relatedPurchaseOrderId   String?
  purchaseOrder            PurchaseOrder?    @relation(fields: [relatedPurchaseOrderId], references: [id], onDelete: SetNull)
  relatedGoodsReceiptId    String?
  goodsReceipt             GoodsReceipt?     @relation(fields: [relatedGoodsReceiptId], references: [id], onDelete: SetNull)
  
  // Operations Task Relations
  operationId              String?
  operation                Operation?        @relation(fields: [operationId], references: [id], onDelete: Cascade)
  startDate                DateTime?
  estimatedHours           Float?
  actualHours              Float?
  completionRate           Int?              @default(0)
  dependencyId             String?
  dependsOn                Task?             @relation("TaskDependencies", fields: [dependencyId], references: [id], onDelete: SetNull)
  dependentTasks           Task[]            @relation("TaskDependencies")

  // Legal Task Relations
  legalCaseId              String?
  legalCase                LegalCase?        @relation(fields: [legalCaseId], references: [id], onDelete: SetNull)
  legalContractId          String?
  legalContract            LegalContract?    @relation(fields: [legalContractId], references: [id], onDelete: SetNull)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  comments          TaskComment[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([relatedVendorId])
  @@index([legalCaseId])
  @@index([legalContractId])
  @@index([relatedPurchaseOrderId])
  @@index([operationId])
  @@index([dependencyId])
  @@index([organizationId, status])
  @@index([assigneeId, status])
}

// ==========================================
// 22. TASK COMMENTS / CONVERSATION
// ==========================================

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    Employee  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([taskId])
  @@index([authorId])
}

// ==========================================
// 23. CALENDAR EVENTS / SCHEDULE
// ==========================================

model CalendarEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creatorId      String
  creator        Employee     @relation("CalendarEventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  
  title          String
  description    String?
  type           String       @default("MEETING") // MEETING, COMPANY_EVENT, CLIENT_MEETING, DEADLINE, OTHER
  startDate      DateTime
  endDate        DateTime
  isAllDay       Boolean      @default(false)
  location       String?
  meetUrl        String?
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendees      String?      // JSON array of employeeIds
  relatedTaskId  String?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([creatorId])
  @@index([startDate])
  @@index([endDate])
  @@index([type])
}

// ==========================================
// 24. ENTERPRISE NOTIFICATIONS
// ==========================================

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type           String       // TASK_ASSIGNED, TASK_DUE, TASK_COMPLETED, LEAVE_REQUEST, LEAVE_APPROVED, LEAVE_REJECTED, MEETING_REMINDER, COMPLIANCE_DEADLINE, SYSTEM
  title          String
  message        String
  priority       String       @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  isRead         Boolean      @default(false)
  readAt         DateTime?
  actionUrl      String?
  metadata       String?      // JSON payload
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@index([userId, isRead])
}

// ==========================================
// 25. CRM: CLIENT / CORPORATE ACCOUNT
// ==========================================

model Client {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code            String        // e.g. "CLI-0001"
  name            String
  industry        String?       // e.g. "Technology", "Financial Services", "Healthcare", "Logistics"
  website         String?
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?
  country         String?       @default("United States")
  postalCode      String?
  taxId           String?       // Tax / VAT / EIN
  status          String        @default("PROSPECT") // LEAD, PROSPECT, ACTIVE, INACTIVE, CHURNED
  tier            String        @default("MID_MARKET") // ENTERPRISE, MID_MARKET, SMB
  ownerId         String?
  owner           Employee?     @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  annualRevenue   Float?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contacts        Contact[]
  opportunities   Opportunity[]
  activities      CrmActivity[]
  tasks           Task[]
  leads           Lead[]
  invoices        Invoice[]
  payments        Payment[]
  operations      Operation[]
  operationIssues OperationIssue[]
  legalContracts  LegalContract[]
  legalCases      LegalCase[]
  legalContacts   LegalContact[]
  onDutyAssignments OnDutyAssignment[]
  estimates       Estimate[]
  salesOrders     SalesOrder[]
  creditNotes     CreditNote[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
  @@index([name])
  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
}

// ==========================================
// 26. CRM: ACCOUNT CONTACT PERSON
// ==========================================

model Contact {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  email           String
  phone           String?
  designation     String?       // Job Title
  department      String?
  isPrimary       Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  opportunities   Opportunity[]
  convertedLeads  Lead[]
  invoices        Invoice[]

  @@index([clientId])
  @@index([email])
}

// ==========================================
// 27. CRM: PROSPECT / INBOUND LEAD
// ==========================================

model Lead {
  id                     String        @id @default(cuid())
  organizationId         String
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName              String
  lastName               String
  companyName            String
  email                  String
  phone                  String?
  jobTitle               String?
  source                 String        @default("WEBSITE") // WEBSITE, REFERRAL, COLD_OUTREACH, CONFERENCE, PARTNER
  status                 String        @default("NEW")     // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CONVERTED, LOST
  estimatedValue         Float?
  ownerId                String?
  owner                  Employee?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  notes                  String?
  
  convertedClientId      String?
  convertedClient        Client?       @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedContactId     String?
  convertedContact       Contact?      @relation(fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedOpportunityId String?
  convertedAt            DateTime?
  
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  activities             CrmActivity[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
  @@index([companyName])
  @@index([email])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// ==========================================
// 28. CRM: SALES OPPORTUNITY / DEAL PIPELINE
// ==========================================

model Opportunity {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String        // Deal title
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId            String?
  owner              Employee?     @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  
  value              Float         @default(0.0)
  stage              String        @default("DISCOVERY") // DISCOVERY, PROPOSAL, NEGOTIATION, CLOSED_WON, CLOSED_LOST
  probability        Int           @default(20)          // 0 to 100
  expectedCloseDate  DateTime
  actualCloseDate    DateTime?
  lossReason         String?
  notes              String?
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  activities         CrmActivity[]
  invoices           Invoice[]
  financialTransactions FinancialTransaction[]
  operations         Operation[]
  legalContracts     LegalContract[]

  @@index([organizationId])
  @@index([clientId])
  @@index([ownerId])
  @@index([stage])
  @@index([expectedCloseDate])
  @@index([organizationId, stage])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, createdAt])
}

// ==========================================
// 29. CRM: CUSTOMER 360 ACTIVITY TIMELINE
// ==========================================

model CrmActivity {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId   String?
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  type            String        // CALL, MEETING, EMAIL, NOTE, TASK, PROPOSAL, STATUS_CHANGE
  subject         String
  description     String?
  performedById   String
  performedBy     Employee      @relation("ActivityPerformer", fields: [performedById], references: [id], onDelete: Cascade)
  performedAt     DateTime      @default(now())
  metadata        String?       // JSON payload
  createdAt       DateTime      @default(now())

  @@index([organizationId])
  @@index([clientId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([performedAt])
  @@index([type])
  @@index([organizationId, performedAt])
}

// ==========================================
// 30. FINANCE: INVOICES
// ==========================================

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber   String        // e.g. "INV-2026-0001"
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId   String?
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  
  // Procurement & AP Relations
  invoiceType     String        @default("SALES") // SALES, VENDOR_PURCHASE
  vendorId        String?
  vendor          Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceiptId  String?
  goodsReceipt    GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  operationId     String?
  operation       Operation?     @relation(fields: [operationId], references: [id], onDelete: SetNull)
  contractId      String?
  contract        LegalContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  invoiceDate     DateTime
  dueDate         DateTime
  currency        String        @default("USD")
  
  subtotal        Float         @default(0.0)
  taxRate         Float         @default(0.0)
  taxAmount       Float         @default(0.0)
  discountRate    Float         @default(0.0)
  discountAmount  Float         @default(0.0)
  total           Float         @default(0.0)
  paidAmount      Float         @default(0.0)
  balance         Float         @default(0.0)
  
  status          String        @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SENT, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  rejectionReason String?
  notes           String?
  terms           String?
  
  createdById     String
  createdBy       Employee      @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedById    String?
  approvedBy      Employee?     @relation("InvoiceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  cancelledAt     DateTime?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]
  payments        Payment[]
  transactions    FinancialTransaction[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([vendorId])
  @@index([purchaseOrderId])
  @@index([operationId])
  @@index([invoiceType])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceDate])
  @@index([contractId])
  @@index([organizationId, invoiceDate, status])
  @@index([organizationId, balance])
}

// ==========================================
// 31. FINANCE: INVOICE LINE ITEMS
// ==========================================

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  productId   String?   // Reference to Product master
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceId   String?   // Reference to Service catalog
  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  quantity    Float     @default(1.0)
  unitPrice   Float     @default(0.0)
  discount    Float     @default(0.0)
  taxRate     Float     @default(0.0)
  amount      Float     @default(0.0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([invoiceId])
  @@index([productId])
  @@index([serviceId])
}

// ==========================================
// 32. FINANCE: PAYMENTS
// ==========================================

model Payment {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentReference String        // e.g. "PAY-2026-0001"
  invoiceId        String
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientId         String?
  client           Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorId         String?
  vendor           Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  
  amount           Float
  currency         String        @default("USD")
  paymentDate      DateTime      @default(now())
  paymentMethod    String        @default("BANK_TRANSFER") // BANK_TRANSFER, CREDIT_CARD, CHECK, CASH, ACH, WIRE
  transactionRef   String?       // External reference number (wire ref, check #)
  notes            String?
  status           String        @default("COMPLETED")     // PENDING, COMPLETED, FAILED, REVERSED
  
  recordedById     String
  recordedBy       Employee      @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Cascade)
  reversedById     String?
  reversedBy       Employee?     @relation("PaymentReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  reversedAt       DateTime?
  reversalReason   String?
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  transactions     FinancialTransaction[]

  @@unique([organizationId, paymentReference])
  @@index([organizationId])
  @@index([invoiceId])
  @@index([clientId])
  @@index([status])
  @@index([paymentDate])
}

// ==========================================
// 33. FINANCE: EXPENSES
// ==========================================

model Expense {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseNumber    String        // e.g. "EXP-2026-0001"
  employeeId       String
  employee         Employee      @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId     String
  department       Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  
  category         String        // TRAVEL, SOFTWARE_SUBSCRIPTION, HARDWARE_EQUIPMENT, OFFICE_SUPPLIES, MARKETING, MEALS_ENTERTAINMENT, CONSULTING, UTILITIES, OTHER
  amount           Float
  currency         String        @default("USD")
  date             DateTime      @default(now())
  description      String
  receiptUrl       String?       // File attachment or uploaded receipt link
  
  status           String        @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, PAID
  approverId       String?
  approver         Employee?     @relation("ExpenseApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  rejectionReason  String?
  paidAt           DateTime?
  paymentMethod    String?       // BANK_TRANSFER, REIMBURSEMENT, CORPORATE_CARD
  paymentReference String?
  operationId      String?
  operation        Operation?    @relation(fields: [operationId], references: [id], onDelete: SetNull)
  contractId       String?
  contract         LegalContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  caseId           String?
  case             LegalCase?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  transactions     FinancialTransaction[]

  @@unique([organizationId, expenseNumber])
  @@index([organizationId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([operationId])
  @@index([status])
  @@index([category])
  @@index([date])
  @@index([contractId])
  @@index([caseId])
  @@index([organizationId, date, status])
}

// ==========================================
// 34. FINANCE: CENTRAL FINANCIAL TRANSACTIONS
// ==========================================

model FinancialTransaction {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactionNumber String        // e.g. "TXN-2026-0001"
  
  type              String        // INVOICE_PAYMENT, EXPENSE, PAYROLL_DISBURSEMENT, ADJUSTMENT
  direction         String        // INFLOW, OUTFLOW
  sourceType        String        // PAYMENT, EXPENSE, PAYROLL_PERIOD, MANUAL
  sourceId          String
  
  amount            Float
  currency          String        @default("USD")
  date              DateTime      @default(now())
  description       String
  reference         String?
  
  departmentId      String?
  department        Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         Employee      @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  
  invoiceId         String?
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId         String?
  payment           Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  expenseId         String?
  expense           Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  payrollPeriodId   String?
  payrollPeriod     PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id], onDelete: SetNull)
  opportunityId     String?
  opportunity       Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  createdAt         DateTime      @default(now())

  @@unique([organizationId, transactionNumber])
  @@index([organizationId])
  @@index([type])
  @@index([direction])
  @@index([date])
  @@index([sourceType, sourceId])
}

// ==========================================
// 36. PRODUCTS & INVENTORY: CATEGORIES
// ==========================================

model ProductCategory {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  description    String?
  type           String            @default("BOTH") // PRODUCT, SERVICE, BOTH
  parentId       String?
  parent         ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       ProductCategory[] @relation("CategoryHierarchy")
  status         String            @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  products       Product[]
  services       Service[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentId])
}

// ==========================================
// 37. PRODUCTS & INVENTORY: PRODUCT MASTER
// ==========================================

model Product {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku               String            // Database-enforced unique SKU
  name              String
  description       String?
  categoryId        String?
  category          ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productType       String            @default("PHYSICAL") // PHYSICAL, CONSUMABLE, ASSET, OTHER
  unitOfMeasure     String            @default("UNIT")     // UNIT, PIECE, BOX, KG, METER, SET
  sellingPrice      Float             @default(0.0)
  costPrice         Float             @default(0.0)        // RBAC restricted visibility
  taxRate           Float             @default(0.0)
  status            String            @default("ACTIVE")   // ACTIVE, INACTIVE, ARCHIVED, DISCONTINUED
  minStockLevel     Float             @default(0.0)
  maxStockLevel     Float             @default(0.0)
  reorderLevel      Float             @default(10.0)
  imageUrl          String?
  isActive          Boolean           @default(true)
  createdById       String
  createdBy         Employee          @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Cascade)
  
  // Future Vendor & PO Architecture Slots
  preferredVendorId String?
  leadTimeDays      Int?              @default(7)
  reorderQuantity   Float?            @default(50.0)

  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  adjustmentItems   InventoryAdjustmentItem[]
  invoiceItems      InvoiceItem[]
  vendorProducts    VendorProduct[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  operationInventories OperationInventory[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([status])
  @@index([categoryId])
  @@index([sku])
}

// ==========================================
// 38. PRODUCTS & INVENTORY: SERVICES CATALOG
// ==========================================

model Service {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceCode    String           // e.g. "SRV-0001"
  name           String
  description    String?
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sellingPrice   Float            @default(0.0)
  costPrice      Float            @default(0.0)
  taxRate        Float            @default(0.0)
  billingUnit    String           @default("HOURLY") // HOURLY, FIXED_PRICE, MONTHLY_RETAINER, DAILY, PER_PROJECT
  status         String           @default("ACTIVE") // ACTIVE, INACTIVE
  isActive       Boolean          @default(true)
  createdById    String
  createdBy      Employee         @relation("ServiceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  
  invoiceItems   InvoiceItem[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, serviceCode])
  @@index([organizationId])
  @@index([status])
  @@index([categoryId])
}

// ==========================================
// 39. PRODUCTS & INVENTORY: WAREHOUSES & LOCATIONS
// ==========================================

model Warehouse {
  id                   String                @id @default(cuid())
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                 String                // e.g. "WH-001"
  name                 String
  address              String?
  city                 String?
  state                String?
  country              String?
  managerId            String?
  manager              Employee?             @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  status               String                @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  isDefault            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  inventoryItems       InventoryItem[]
  sourceMovements      StockMovement[]       @relation("SourceWarehouseMovements")
  destinationMovements StockMovement[]       @relation("DestinationWarehouseMovements")
  adjustments          InventoryAdjustment[]
  goodsReceipts        GoodsReceipt[]
  operationInventories OperationInventory[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
}

// ==========================================
// 40. PRODUCTS & INVENTORY: LOCATION-AWARE INVENTORY ITEMS
// ==========================================

model InventoryItem {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity         Float        @default(0.0) // Physical on-hand stock
  reservedQuantity Float        @default(0.0) // Reserved for confirmed orders
  aisle            String?
  shelf            String?
  bin              String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, warehouseId])
  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
}

// ==========================================
// 41. PRODUCTS & INVENTORY: STOCK MOVEMENTS
// ==========================================

model StockMovement {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movementNumber         String       // e.g. "MOV-2026-0001"
  productId              String
  product                Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type                   String       // STOCK_IN, STOCK_OUT, TRANSFER, ADJUSTMENT, RETURN
  quantity               Float        // Positive magnitude moved
  sourceWarehouseId      String?
  sourceWarehouse        Warehouse?   @relation("SourceWarehouseMovements", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  destinationWarehouseId String?
  destinationWarehouse   Warehouse?   @relation("DestinationWarehouseMovements", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  referenceType          String       @default("MANUAL") // MANUAL, PURCHASE_ORDER, INVOICE, TRANSFER, ADJUSTMENT
  referenceId            String?
  reason                 String
  previousBalance        Float
  newBalance             Float
  performedById          String
  performedBy            Employee     @relation("StockMovementPerformer", fields: [performedById], references: [id], onDelete: Cascade)
  notes                  String?
  createdAt              DateTime     @default(now())

  @@unique([organizationId, movementNumber])
  @@index([organizationId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
}

// ==========================================
// 42. PRODUCTS & INVENTORY: INVENTORY ADJUSTMENTS
// ==========================================

model InventoryAdjustment {
  id               String                    @id @default(cuid())
  organizationId   String
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adjustmentNumber String                    // e.g. "ADJ-2026-0001"
  warehouseId      String
  warehouse        Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  status           String                    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  reason           String                    // DAMAGED_GOODS, LOST_GOODS, PHYSICAL_COUNT_DISCREPANCY, EXPIRATION, CORRECTION, OTHER
  notes            String?
  requestedById    String
  requestedBy      Employee                  @relation("AdjustmentRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedById     String?
  approvedBy       Employee?                 @relation("AdjustmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  rejectionReason  String?
  items            InventoryAdjustmentItem[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([organizationId, adjustmentNumber])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([status])
}

model InventoryAdjustmentItem {
  id                 String              @id @default(cuid())
  adjustmentId       String
  adjustment         InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  systemQuantity     Float               // Before
  countedQuantity    Float               // Physical count
  adjustmentQuantity Float               // Difference (counted - system)
  unitCost           Float               @default(0.0)

  @@index([adjustmentId])
  @@index([productId])
}

// ==========================================
// 43. VENDORS & PROCUREMENT: VENDOR MASTER
// ==========================================

model Vendor {
  id                     String          @id @default(cuid())
  organizationId         String
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorCode             String          // e.g. "VEN-0001"
  legalName              String
  displayName            String
  vendorType             String          @default("SUPPLIER") // SUPPLIER, DISTRIBUTOR, MANUFACTURER, SERVICE_PROVIDER, WHOLESALER, CONTRACTOR
  email                  String
  phone                  String?
  website                String?
  address                String?
  city                   String?
  state                  String?
  country                String?         @default("United States")
  taxId                  String?         // Tax / GST / VAT / EIN
  paymentTerms           String          @default("NET_30")   // NET_15, NET_30, NET_60, DUE_ON_RECEIPT, ADVANCE
  currency               String          @default("USD")
  bankName               String?
  bankAccountNumberMasked String?
  bankRoutingCode        String?         // Swift / Routing / IFSC
  bankBranch             String?
  primaryContactName     String?
  primaryContactEmail    String?
  primaryContactPhone    String?
  status                 String          @default("ACTIVE")   // ACTIVE, INACTIVE, BLOCKED, PENDING_REVIEW
  notes                  String?
  createdById            String
  createdBy              Employee        @relation("VendorCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  contacts               VendorContact[]
  vendorProducts         VendorProduct[]
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  invoices               Invoice[]
  payments               Payment[]
  tasks                  Task[]
  operationVendors       OperationVendor[]
  legalContracts         LegalContract[]
  legalCases             LegalCase[]
  legalContacts          LegalContact[]
  vendorCredits          VendorCredit[]

  @@unique([organizationId, vendorCode])
  @@index([organizationId])
  @@index([status])
  @@index([vendorType])
  @@index([displayName])
}

// ==========================================
// 44. VENDORS & PROCUREMENT: VENDOR CONTACTS
// ==========================================

model VendorContact {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  email       String
  phone       String?
  isPrimary   Boolean   @default(false)
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([vendorId])
  @@index([email])
}

// ==========================================
// 45. VENDORS & PROCUREMENT: VENDOR-PRODUCT CATALOG
// ==========================================

model VendorProduct {
  id               String    @id @default(cuid())
  vendorId         String
  vendor           Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorSku        String?
  purchasePrice    Float     @default(0.0)
  currency         String    @default("USD")
  leadTimeDays     Int       @default(7)
  minOrderQuantity Float     @default(1.0)
  isPreferred      Boolean   @default(false)
  status           String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([vendorId, productId])
  @@index([vendorId])
  @@index([productId])
}

// ==========================================
// 46. VENDORS & PROCUREMENT: PURCHASE REQUESTS
// ==========================================

model PurchaseRequest {
  id                       String                @id @default(cuid())
  organizationId           String
  organization             Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestNumber            String                // e.g. "PR-2026-0001"
  requesterId              String
  requester                Employee              @relation("PurchaseRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  departmentId             String
  department               Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requestDate              DateTime              @default(now())
  requiredDate             DateTime
  reason                   String
  priority                 String                @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  estimatedCost            Float                 @default(0.0)
  status                   String                @default("DRAFT")  // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, CANCELLED, CONVERTED_TO_PO
  reviewedById             String?
  reviewedBy               Employee?             @relation("PurchaseRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt               DateTime?
  approvedById             String?
  approvedBy               Employee?             @relation("PurchaseRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt               DateTime?
  rejectionReason          String?
  convertedPurchaseOrderId String?
  notes                    String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  items                    PurchaseRequestItem[]
  purchaseOrders           PurchaseOrder[]
  tasks                    Task[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId])
  @@index([requesterId])
  @@index([departmentId])
  @@index([status])
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  description       String
  quantity          Float           @default(1.0)
  estimatedUnitCost Float           @default(0.0)
  estimatedTotal    Float           @default(0.0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([purchaseRequestId])
  @@index([productId])
}

// ==========================================
// 47. VENDORS & PROCUREMENT: PURCHASE ORDERS
// ==========================================

model PurchaseOrder {
  id                   String              @id @default(cuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poNumber             String              // e.g. "PO-2026-0001"
  vendorId             String
  vendor               Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  purchaseRequestId    String?
  purchaseRequest      PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  poDate               DateTime            @default(now())
  expectedDeliveryDate DateTime
  currency             String              @default("USD")
  paymentTerms         String              @default("NET_30")
  shippingAddress      String?
  billingAddress       String?
  subtotal             Float               @default(0.0)
  discountRate         Float               @default(0.0)
  discountAmount       Float               @default(0.0)
  taxRate              Float               @default(0.0)
  taxAmount            Float               @default(0.0)
  total                Float               @default(0.0)
  status               String              @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SENT, PARTIALLY_RECEIVED, RECEIVED, CLOSED, CANCELLED
  createdById          String
  createdBy            Employee            @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedById         String?
  approvedBy           Employee?           @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  sentAt               DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  notes                String?
  terms                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items                PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]
  invoices             Invoice[]
  tasks                Task[]
  operations           Operation[]
  operationVendors     OperationVendor[]
  legalContracts       LegalContract[]

  @@unique([organizationId, poNumber])
  @@index([organizationId])
  @@index([vendorId])
  @@index([status])
  @@index([poDate])
}

model PurchaseOrderItem {
  id               String              @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  description      String
  quantity         Float               @default(1.0)
  unitCost         Float               @default(0.0)
  discount         Float               @default(0.0)
  tax              Float               @default(0.0)
  total            Float               @default(0.0)
  receivedQuantity Float               @default(0.0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  receiptItems     GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

// ==========================================
// 48. VENDORS & PROCUREMENT: GOODS RECEIPTS
// ==========================================

model GoodsReceipt {
  id              String             @id @default(cuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptNumber   String             // e.g. "GR-2026-0001"
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  receivedDate    DateTime           @default(now())
  receivedById    String
  receivedBy      Employee           @relation("GoodsReceiver", fields: [receivedById], references: [id], onDelete: Cascade)
  status          String             @default("DRAFT") // DRAFT, FINALIZED, CANCELLED
  finalizedAt     DateTime?
  finalizedById   String?
  finalizedBy     Employee?          @relation("GoodsReceiptFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  notes           String?
  attachments     String?            // JSON array of URLs
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items           GoodsReceiptItem[]
  invoices        Invoice[]
  tasks           Task[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([warehouseId])
  @@index([status])
}

model GoodsReceiptItem {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  productId           String
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderedQuantity     Float
  receivedQuantity    Float
  rejectedQuantity    Float             @default(0.0)
  acceptedQuantity    Float             @default(0.0)
  rejectionReason     String?
  unitCost            Float             @default(0.0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([productId])
}

// ==========================================
// 49. OPERATIONS MANAGEMENT: OPERATION MASTER
// ==========================================

model Operation {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operationCode          String             // e.g. "OP-2026-0001"
  name                   String
  description            String?
  operationType          String             @default("CLIENT_DELIVERY") // CLIENT_DELIVERY, INTERNAL_INITIATIVE, INFRASTRUCTURE, MAINTENANCE, ON_SITE_SERVICE, PROCUREMENT_LOGISTICS
  
  departmentId           String
  department             Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  ownerId                String
  owner                  Employee           @relation("OperationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Relationships
  clientId               String?
  client                 Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  opportunityId          String?
  opportunity            Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  projectName            String?            // Associated project reference
  purchaseOrderId        String?
  purchaseOrder          PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  
  // Workflow & Health
  priority               String             @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status                 String             @default("PLANNING") // PLANNING, SCHEDULED, IN_PROGRESS, QUALITY_REVIEW, ON_HOLD, COMPLETED, CANCELLED
  progress               Int                @default(0) // 0 to 100
  riskLevel              String             @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  riskDescription        String?
  mitigationPlan         String?
  
  // Schedule
  startDate              DateTime
  expectedCompletionDate DateTime
  actualCompletionDate   DateTime?
  estimatedHours         Float              @default(0.0)
  actualHours            Float              @default(0.0)
  
  // Financial
  estimatedCost          Float              @default(0.0)
  approvedBudget         Float              @default(0.0)
  actualCost             Float              @default(0.0)
  
  // Notes & Attachments
  internalNotes          String?
  attachments            String?            // JSON array of { name, url, size }
  
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tasks                  Task[]
  teamMembers            OperationEmployee[]
  inventoryItems         OperationInventory[]
  vendors                OperationVendor[]
  issues                 OperationIssue[]
  approvals              ApprovalRequest[]
  milestones             OperationMilestone[]
  documents              OperationDocument[]
  activities             OperationActivity[]
  invoices               Invoice[]
  expenses               Expense[]
  legalContracts         LegalContract[]

  @@unique([organizationId, operationCode])
  @@index([organizationId])
  @@index([departmentId])
  @@index([ownerId])
  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@index([riskLevel])
  @@index([startDate])
  @@index([expectedCompletionDate])
}

// ==========================================
// 50. OPERATIONS: ASSIGNED TEAM / PERSONNEL
// ==========================================

model OperationEmployee {
  id             String       @id @default(cuid())
  operationId    String
  operation      Operation    @relation(fields: [operationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation("OperationAssignedEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // LEAD, SPECIALIST, ENGINEER, COORDINATOR, MEMBER
  assignedHours  Float        @default(0.0)
  actualHours    Float        @default(0.0)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([operationId, employeeId])
  @@index([operationId])
  @@index([employeeId])
}

// ==========================================
// 51. OPERATIONS: REQUIRED INVENTORY ALLOCATION
// ==========================================

model OperationInventory {
  id                String     @id @default(cuid())
  operationId       String
  operation         Operation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  productId         String
  product           Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId       String?
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  requiredQuantity  Float      @default(1.0)
  allocatedQuantity Float      @default(0.0)
  usedQuantity      Float      @default(0.0)
  unitCost          Float      @default(0.0)
  status            String     @default("PLANNED") // PLANNED, ALLOCATED, CONSUMED, RETURNED
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([operationId])
  @@index([productId])
  @@index([warehouseId])
}

// ==========================================
// 52. OPERATIONS: VENDOR LINKAGE
// ==========================================

model OperationVendor {
  id              String         @id @default(cuid())
  operationId     String
  operation       Operation      @relation(fields: [operationId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  role            String?        @default("SUPPLIER") // SUPPLIER, SUBCONTRACTOR, LOGISTICS, CONSULTANT
  estimatedCost   Float          @default(0.0)
  actualCost      Float          @default(0.0)
  status          String         @default("PLANNED")  // PLANNED, ENGAGED, COMPLETED, CANCELLED
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([operationId])
  @@index([vendorId])
  @@index([purchaseOrderId])
}

// ==========================================
// 53. OPERATIONS: ISSUES & INCIDENTS
// ==========================================

model OperationIssue {
  id              String                  @id @default(cuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issueCode       String                  // e.g. "ISS-2026-0001"
  title           String
  description     String
  operationId     String
  operation       Operation               @relation(fields: [operationId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  reportedById    String
  reportedBy      Employee                @relation("IssueReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  assignedToId    String?
  assignedTo      Employee?               @relation("IssueAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  severity        String                  @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status          String                  @default("OPEN")   // OPEN, INVESTIGATING, IN_PROGRESS, RESOLVED, CLOSED
  dueDate         DateTime?
  resolutionNotes String?
  attachments     String?                 // JSON array of URLs
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  comments        OperationIssueComment[]

  @@unique([organizationId, issueCode])
  @@index([organizationId])
  @@index([operationId])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([status])
  @@index([severity])
}

// ==========================================
// 54. OPERATIONS: ISSUE RESOLUTION COMMENTS
// ==========================================

model OperationIssueComment {
  id        String         @id @default(cuid())
  issueId   String
  issue     OperationIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    Employee       @relation("IssueCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([issueId])
  @@index([authorId])
}

// ==========================================
// 55. OPERATIONS: MILESTONES
// ==========================================

model OperationMilestone {
  id          String    @id @default(cuid())
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime
  completedAt DateTime?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, DELAYED
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([operationId])
  @@index([status])
  @@index([dueDate])
}

// ==========================================
// 56. OPERATIONS: DOCUMENTS & DELIVERABLES
// ==========================================

model OperationDocument {
  id           String    @id @default(cuid())
  operationId  String
  operation    Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  name         String
  fileUrl      String
  fileSize     Int?
  fileType     String?
  category     String?   @default("DELIVERABLE") // SPECIFICATION, REPORT, CONTRACT, DELIVERABLE, OTHER
  uploadedById String
  uploadedBy   Employee  @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([operationId])
  @@index([uploadedById])
}

// ==========================================
// 57. OPERATIONS: ACTIVITY TIMELINE
// ==========================================

model OperationActivity {
  id            String    @id @default(cuid())
  operationId   String
  operation     Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  type          String    // CREATED, STATUS_CHANGED, OWNER_ASSIGNED, TASK_CREATED, TASK_COMPLETED, INVENTORY_ALLOCATED, VENDOR_ASSIGNED, PO_LINKED, ISSUE_REPORTED, ISSUE_RESOLVED, APPROVAL_REQUESTED, APPROVAL_DECIDED, COMPLETED, NOTE_ADDED
  description   String
  performedById String?
  performedBy   Employee? @relation("OperationActivityPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  metadata      String?   // JSON string
  createdAt     DateTime  @default(now())

  @@index([operationId])
  @@index([performedById])
  @@index([type])
  @@index([createdAt])
}

// ==========================================
// 58. GENERIC APPROVALS WORKFLOW
// ==========================================

model ApprovalRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String       // OPERATION, PURCHASE_ORDER, EXPENSE, BUDGET_CHANGE, CONTRACT, CONTRACT_TERMINATION, LEGAL_SETTLEMENT, COMPLIANCE_EXCEPTION, OTHER
  entityId       String
  operationId    String?
  operation      Operation?   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  contractId     String?
  contract       LegalContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  requestedById  String
  requestedBy    Employee     @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approverId     String?
  approver       Employee?    @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  decisionDate   DateTime?
  comment        String?
  metadata       String?      // JSON payload
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([operationId])
  @@index([contractId])
  @@index([requestedById])
  @@index([approverId])
  @@index([status])
  @@index([entityType, entityId])
}

// ==========================================
// 59. LEGAL: CONTRACT MASTER
// ==========================================

model LegalContract {
  id                  String             @id @default(cuid())
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractNumber      String             // e.g. "CTR-2026-0001"
  title               String
  description         String?
  contractType        String             @default("CUSTOMER_MSA") // CUSTOMER_MSA, VENDOR_AGREEMENT, EMPLOYMENT_CONTRACT, NDA, SLA, PARTNERSHIP, LEASE, LICENSING, OTHER
  
  departmentId        String?
  department          Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  legalOwnerId        String
  legalOwner          Employee           @relation("LegalContractLegalOwner", fields: [legalOwnerId], references: [id], onDelete: Cascade)
  businessOwnerId     String?
  businessOwner       Employee?          @relation("LegalContractBusinessOwner", fields: [businessOwnerId], references: [id], onDelete: SetNull)
  
  // Primary Party Relations
  partyType           String             @default("CLIENT") // CLIENT, VENDOR, EMPLOYEE, PARTNER, OTHER
  clientId            String?
  client              Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vendorId            String?
  vendor              Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  employeeId          String?
  employee            Employee?          @relation("LegalContractEmployeeParty", fields: [employeeId], references: [id], onDelete: SetNull)
  externalPartyName   String?
  
  // Terms & Lifecycle Dates
  effectiveDate       DateTime
  expiryDate          DateTime
  renewalDate         DateTime?
  renewalType         String             @default("MANUAL") // AUTOMATIC, MANUAL, NONE
  noticePeriodDays    Int                @default(30)
  contractValue       Float              @default(0.0)
  currency            String             @default("USD")
  paymentTerms        String?
  
  // Workflow State Machine
  status              String             @default("DRAFT") // DRAFT, UNDER_REVIEW, PENDING_APPROVAL, APPROVED, ACTIVE, EXPIRING_SOON, EXPIRED, TERMINATED, ARCHIVED
  
  // Risk & Mitigation
  riskLevel           String             @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  riskDescription     String?
  keyRisks            String?
  mitigationPlan      String?
  
  // Cross-Module Links
  purchaseOrderId     String?
  purchaseOrder       PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  operationId         String?
  operation           Operation?         @relation(fields: [operationId], references: [id], onDelete: SetNull)
  opportunityId       String?
  opportunity         Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  
  internalNotes       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  parties             LegalContractParty[]
  renewals            LegalRenewal[]
  approvals           ApprovalRequest[]
  documents           LegalDocument[]
  activities          LegalActivity[]
  deadlines           LegalDeadline[]
  cases               LegalCase[]
  risks               LegalRisk[]
  invoices            Invoice[]
  expenses            Expense[]
  tasks               Task[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId])
  @@index([departmentId])
  @@index([legalOwnerId])
  @@index([businessOwnerId])
  @@index([clientId])
  @@index([vendorId])
  @@index([employeeId])
  @@index([status])
  @@index([contractType])
  @@index([riskLevel])
  @@index([expiryDate])
  @@index([renewalDate])
}

// ==========================================
// 60. LEGAL: MULTI-PARTY SIGNATORIES
// ==========================================

model LegalContractParty {
  id              String         @id @default(cuid())
  contractId      String
  contract        LegalContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  partyName       String
  partyRole       String         @default("PARTY_B") // PARTY_A, PARTY_B, GUARANTOR, WITNESS, COUNSEL
  signatoryName   String?
  signatoryEmail  String?
  signedAt        DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([contractId])
}

// ==========================================
// 61. LEGAL: CONTRACT RENEWAL HISTORY
// ==========================================

model LegalRenewal {
  id                 String         @id @default(cuid())
  contractId         String
  contract           LegalContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  renewalNumber      Int            @default(1)
  previousExpiryDate DateTime
  newExpiryDate      DateTime
  noticeDeadline     DateTime?
  renewalType        String         @default("MANUAL") // AUTOMATIC, MANUAL
  renewalValue       Float?
  status             String         @default("PENDING") // PENDING, COMPLETED, CANCELLED
  notes              String?
  initiatedById      String
  initiatedBy        Employee       @relation("RenewalInitiator", fields: [initiatedById], references: [id], onDelete: Cascade)
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([contractId])
  @@index([initiatedById])
  @@index([status])
}

// ==========================================
// 62. LEGAL: CASES & LITIGATION
// ==========================================

model LegalCase {
  id                        String             @id @default(cuid())
  organizationId            String
  organization              Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caseNumber                String             // e.g. "CASE-2026-0001"
  title                     String
  caseType                  String             @default("DISPUTE") // LITIGATION, DISPUTE, CLAIM, INVESTIGATION, REGULATORY, EMPLOYMENT, INTELLECTUAL_PROPERTY, CONTRACT_DISPUTE, OTHER
  description               String?
  status                    String             @default("OPEN") // OPEN, INVESTIGATING, IN_PROGRESS, AWAITING_ACTION, RESOLVED, CLOSED
  priority                  String             @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  riskLevel                 String             @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  
  internalOwnerId           String
  internalOwner             Employee           @relation("LegalCaseInternalOwner", fields: [internalOwnerId], references: [id], onDelete: Cascade)
  externalCounselId         String?
  externalCounsel           LegalContact?      @relation(fields: [externalCounselId], references: [id], onDelete: SetNull)
  
  opposingParty             String?
  opposingCounsel           String?
  courtJurisdiction         String?
  judgeOrArbitrator         String?
  
  clientId                  String?
  client                    Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vendorId                  String?
  vendor                    Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  employeeId                String?
  employee                  Employee?          @relation("LegalCaseEmployeeParty", fields: [employeeId], references: [id], onDelete: SetNull)
  contractId                String?
  contract                  LegalContract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  
  openDate                  DateTime           @default(now())
  targetResolutionDate      DateTime?
  actualResolutionDate      DateTime?
  estimatedFinancialExposure Float             @default(0.0)
  actualFinancialExposure    Float             @default(0.0)
  resolutionNotes           String?
  notes                     String?
  
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  events                    LegalCaseEvent[]
  documents                 LegalDocument[]
  tasks                     Task[]
  expenses                  Expense[]
  deadlines                 LegalDeadline[]
  activities                LegalActivity[]
  risks                     LegalRisk[]

  @@unique([organizationId, caseNumber])
  @@index([organizationId])
  @@index([internalOwnerId])
  @@index([externalCounselId])
  @@index([status])
  @@index([caseType])
  @@index([riskLevel])
  @@index([clientId])
  @@index([vendorId])
  @@index([contractId])
}

// ==========================================
// 63. LEGAL: CASE EVENTS & PROCEEDINGS
// ==========================================

model LegalCaseEvent {
  id              String         @id @default(cuid())
  caseId          String
  case            LegalCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  eventType       String         // HEARING, FILING, MEETING, DECISION, COMMUNICATION, INTERNAL_ACTION
  title           String
  description     String?
  eventDate       DateTime
  location        String?
  performedById   String?
  outcome         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([caseId])
  @@index([eventType])
  @@index([eventDate])
}

// ==========================================
// 64. LEGAL: STATUTORY COMPLIANCE
// ==========================================

model LegalCompliance {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String               // e.g. "CMP-2026-0001"
  title             String
  regulation        String               // e.g. "GDPR", "SOC2", "HIPAA", "ISO27001", "OSHA"
  jurisdiction      String               // e.g. "Federal", "Global", "California", "EU"
  departmentId      String?
  department        Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownerId           String
  owner             Employee             @relation("LegalComplianceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  frequency         String               @default("YEARLY") // ONE_TIME, MONTHLY, QUARTERLY, HALF_YEARLY, YEARLY
  lastCompletedDate DateTime?
  nextDueDate       DateTime
  status            String               @default("COMPLIANT") // COMPLIANT, DUE_SOON, OVERDUE, AT_RISK, NOT_APPLICABLE
  riskLevel         String               @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  description       String?
  notes             String?
  
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  evidences         ComplianceEvidence[]
  documents         LegalDocument[]
  deadlines         LegalDeadline[]
  activities        LegalActivity[]
  risks             LegalRisk[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@index([ownerId])
  @@index([status])
  @@index([riskLevel])
  @@index([nextDueDate])
}

// ==========================================
// 65. LEGAL: COMPLIANCE EVIDENCE
// ==========================================

model ComplianceEvidence {
  id              String           @id @default(cuid())
  complianceId    String
  compliance      LegalCompliance  @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  evidenceType    String?          // CERTIFICATE, AUDIT_REPORT, POLICY_ATTESTATION, LOG_EXPORT, OTHER
  fileUrl         String?
  submittedById   String
  submittedBy     Employee         @relation("ComplianceEvidenceSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  verifiedById    String?
  verifiedBy      Employee?        @relation("ComplianceEvidenceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?
  status          String           @default("SUBMITTED") // SUBMITTED, VERIFIED, REJECTED
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([complianceId])
  @@index([submittedById])
  @@index([status])
}

// ==========================================
// 66. LEGAL: EXTERNAL CONTACTS & COUNSEL
// ==========================================

model LegalContact {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  firmName       String?
  role           String?        // e.g. "Senior Partner", "General Counsel", "Compliance Inspector"
  email          String
  phone          String?
  contactType    String         @default("EXTERNAL_COUNSEL") // EXTERNAL_COUNSEL, LAW_FIRM, REGULATOR, GOVERNMENT, ARBITRATOR, NOTARY, OTHER
  address        String?
  notes          String?
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vendorId       String?
  vendor         Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  cases          LegalCase[]

  @@index([organizationId])
  @@index([contactType])
  @@index([email])
}

// ==========================================
// 67. LEGAL: DEADLINES & STATUTORY HORIZONS
// ==========================================

model LegalDeadline {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  deadlineType   String           // CONTRACT_EXPIRY, RENEWAL_NOTICE, COMPLIANCE_DEADLINE, FILING_DEADLINE, CASE_HEARING, RESPONSE_DEADLINE, INTERNAL_REVIEW, APPROVAL_DEADLINE
  dueDate        DateTime
  priority       String           @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status         String           @default("UPCOMING") // UPCOMING, DUE_TODAY, OVERDUE, COMPLETED
  completedAt    DateTime?
  
  contractId     String?
  contract       LegalContract?   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  caseId         String?
  case           LegalCase?       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  complianceId   String?
  compliance     LegalCompliance? @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  
  ownerId        String
  owner          Employee         @relation("LegalDeadlineOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  notes          String?
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([contractId])
  @@index([caseId])
  @@index([complianceId])
  @@index([ownerId])
}

// ==========================================
// 68. LEGAL: VERSION-TRACKED DOCUMENTS
// ==========================================

model LegalDocument {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  documentType   String                 @default("CONTRACT") // CONTRACT, AGREEMENT, AMENDMENT, COURT_FILING, COMPLIANCE_EVIDENCE, CORRESPONDENCE, POLICY, CERTIFICATE, OTHER
  
  contractId     String?
  contract       LegalContract?         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  caseId         String?
  case           LegalCase?             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  complianceId   String?
  compliance     LegalCompliance?       @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  
  currentVersion Int                    @default(1)
  latestFileUrl  String
  latestFileName String
  latestFileSize Int?
  latestFileType String?
  
  uploadedById   String
  uploadedBy     Employee               @relation("LegalDocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  versions       LegalDocumentVersion[]

  @@index([organizationId])
  @@index([contractId])
  @@index([caseId])
  @@index([complianceId])
  @@index([documentType])
}

model LegalDocumentVersion {
  id                String         @id @default(cuid())
  documentId        String
  document          LegalDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version           Int
  fileUrl           String
  fileName          String
  fileSize          Int?
  fileType          String?
  changeDescription String?
  uploadedById      String
  uploadedBy        Employee       @relation("LegalDocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())

  @@unique([documentId, version])
  @@index([documentId])
  @@index([uploadedById])
}

// ==========================================
// 69. LEGAL: RISK REGISTER
// ==========================================

model LegalRisk {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  riskCode       String           // e.g. "RSK-2026-0001"
  title          String
  description    String?
  
  contractId     String?
  contract       LegalContract?   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  caseId         String?
  case           LegalCase?       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  complianceId   String?
  compliance     LegalCompliance? @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  
  probability    Int              @default(3) // 1 to 5
  impact         Int              @default(3) // 1 to 5
  riskScore      Int              @default(9) // probability * impact (1 to 25)
  riskLevel      String           @default("MEDIUM") // LOW (1-6), MEDIUM (7-14), HIGH (15-19), CRITICAL (20-25)
  
  ownerId        String
  owner          Employee         @relation("LegalRiskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  mitigationPlan String?
  status         String           @default("IDENTIFIED") // IDENTIFIED, ASSESSED, MITIGATING, ACCEPTED, RESOLVED, CLOSED
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, riskCode])
  @@index([organizationId])
  @@index([contractId])
  @@index([caseId])
  @@index([complianceId])
  @@index([riskLevel])
  @@index([status])
  @@index([ownerId])
}

// ==========================================
// 70. LEGAL: ACTIVITY AUDIT TRAIL
// ==========================================

model LegalActivity {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  contractId     String?
  contract       LegalContract?   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  caseId         String?
  case           LegalCase?       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  complianceId   String?
  compliance     LegalCompliance? @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  
  type           String           // CREATED, UPDATED, STATUS_CHANGED, SUBMITTED, REVIEWED, APPROVED, REJECTED, RENEWED, AMENDED, TERMINATED, DOCUMENT_UPLOADED, VERSION_CREATED, EVENT_LOGGED, EVIDENCE_SUBMITTED, RISK_UPDATED
  description    String
  performedById  String?
  performedBy    Employee?        @relation("LegalActivityPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  metadata       String?          // JSON payload
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([contractId])
  @@index([caseId])
  @@index([complianceId])
  @@index([type])
  @@index([createdAt])
}

// ==========================================
// 71. EMPLOYEE SELF-SERVICE REQUESTS
// ==========================================

model EmployeeRequest {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestNumber   String        // e.g. "REQ-2026-0001"
  category        String        // LEAVE, ATTENDANCE_CORRECTION, ON_DUTY, EXPENSE, HR_DOCUMENT, IT_SUPPORT, OTHER
  title           String
  description     String
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  
  employeeId      String
  employee        Employee      @relation("EmployeeRequestsSubmitted", fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  approverId      String?
  approver        Employee?     @relation("EmployeeRequestsApproved", fields: [approverId], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  metadata        String?       // JSON payload
  attachmentUrl   String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, requestNumber])
  @@index([organizationId])
  @@index([employeeId])
  @@index([category])
  @@index([status])
}

// ==========================================
// 72. ON-DUTY FIELD ASSIGNMENTS
// ==========================================

model OnDutyAssignment {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignmentNumber String        // e.g. "OD-2026-0001"
  
  employeeId       String
  employee         Employee      @relation("OnDutyEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  clientId         String?
  client           Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName       String?
  location         String
  date             DateTime
  purpose          String
  status           String        @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED
  
  reportNotes      String?
  startedAt        DateTime?
  completedAt      DateTime?
  attachmentUrl    String?
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([organizationId, assignmentNumber])
  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@index([date])
}

// ==========================================
// 73. DASHBOARD PREFERENCES
// ==========================================

model DashboardPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layoutMode     String   @default("COMFORTABLE") // COMFORTABLE, COMPACT
  enabledWidgets String?  // JSON array of widget keys
  widgetOrder    String?  // JSON array of ordered widget keys
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// 74. WORKFLOW AUTOMATION & SMART ACTIONS
// ==========================================

model Workflow {
  id               String              @id @default(cuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String              // e.g. "WF-0001"
  name             String
  description      String?
  module           String              // CRM, FINANCE, HR, PROJECTS, INVENTORY, VENDORS, CONTRACTS, COMPLIANCE, TASKS
  triggerType      String              // RECORD_CREATED, RECORD_UPDATED, STATUS_CHANGED, DUE_DATE_APPROACHING, DUE_DATE_PASSED, AMOUNT_EXCEEDS_THRESHOLD, INVENTORY_BELOW_THRESHOLD, APPROVAL_CREATED, APPROVAL_PENDING, PAYMENT_RECEIVED, TASK_OVERDUE
  triggerConfig    String?             // JSON configuration string
  conditions       String              @default("[]") // JSON array of { field, operator, value, logicalOperator }
  actions          String              @default("[]") // JSON array of { type, target, payload, priority }
  priority         String              @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status           String              @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, DISABLED
  isTemplate       Boolean             @default(false)
  templateCategory String?
  executionCount   Int                 @default(0)
  lastExecutedAt   DateTime?
  
  createdById      String?
  createdBy        Employee?           @relation("WorkflowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  executions       WorkflowExecution[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([module])
  @@index([triggerType])
  @@index([status])
}

model WorkflowExecution {
  id              String       @id @default(cuid())
  workflowId      String
  workflow        Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  triggerEvent    String       // Event name that triggered this run
  entityType      String       // Entity type (e.g. "Invoice", "Lead", "Contract")
  entityId        String?      // Entity record ID
  status          String       // SUCCESS, FAILED, SKIPPED, PARTIAL
  actionsExecuted String       @default("[]") // JSON array of actions performed and outputs
  error           String?
  durationMs      Int          @default(0)
  metadata        String?      // JSON payload of trigger input
  executedAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([workflowId])
  @@index([status])
  @@index([executedAt])
  @@index([entityId])
}

// ==========================================
// 75. COMMUNICATION & COLLABORATION HUB
// ==========================================

model Conversation {
  id              String                    @id @default(cuid())
  organizationId  String
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            String                    @default("DIRECT") // DIRECT, GROUP, CHANNEL, RECORD
  title           String?                   // For groups, channels, or custom topics
  description     String?
  recordType      String?                   // CLIENT, LEAD, OPERATION, TASK, INVOICE, CONTRACT, VENDOR, PURCHASE_ORDER, EMPLOYEE
  recordId        String?                   // Associated CRM record ID
  departmentId    String?                   // For department channels (e.g. #engineering)
  channelCode     String?                   // e.g. "general", "engineering", "finance"
  isPrivate       Boolean                   @default(false)
  isArchived      Boolean                   @default(false)
  
  createdById     String
  createdBy       Employee                  @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  
  lastMessageAt   DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  participants    ConversationParticipant[]
  messages        Message[]

  @@index([organizationId])
  @@index([type])
  @@index([recordType, recordId])
  @@index([departmentId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role            String       @default("MEMBER") // OWNER, ADMIN, MEMBER
  lastReadAt      DateTime     @default(now())
  joinedAt        DateTime     @default(now())

  @@unique([conversationId, employeeId])
  @@index([conversationId])
  @@index([employeeId])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          Employee     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  
  content         String
  parentId        String?
  parent          Message?     @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies         Message[]    @relation("ThreadReplies")
  
  priority        String       @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  isInternal      Boolean      @default(true) // True = internal staff only, False = client visible
  isEdited        Boolean      @default(false)
  editedAt        DateTime?
  isDeleted       Boolean      @default(false)
  
  attachments     String?      // JSON array of { name, url, size, type }
  mentions        String?      // JSON array of employee IDs or names
  reactions       String?      // JSON array of { emoji, employeeId, employeeName }
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([parentId])
  @@index([createdAt])
}

model Announcement {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title              String
  content            String
  priority           String             @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  audienceType       String             @default("ALL") // ALL, DEPARTMENT, ROLE, SELECTED
  targetDepartmentId String?
  targetRole         String?
  
  authorId           String
  author             Employee           @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  publishedAt        DateTime           @default(now())
  expiresAt          DateTime?
  attachments        String?            // JSON array of URLs
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  reads              AnnouncementRead[]

  @@index([organizationId])
  @@index([authorId])
  @@index([publishedAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, employeeId])
  @@index([announcementId])
  @@index([employeeId])
}

// ==========================================
// 76. AI LAYER & EXECUTIVE INTELLIGENCE
// ==========================================

model AIConversation {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String         @default("New Intelligence Session")
  contextRecordType   String?        // CLIENT, LEAD, OPERATION, INVOICE, CONTRACT, EMPLOYEE, DASHBOARD
  contextRecordId     String?        // Associated CRM record ID if context-anchored
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  messages            AIMessage[]

  @@index([organizationId])
  @@index([userId])
  @@index([contextRecordType, contextRecordId])
}

model AIMessage {
  id              String         @id @default(cuid())
  conversationId  String
  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String         // USER, ASSISTANT, SYSTEM
  content         String
  sources         String?        // JSON array of { id, type, title, url, snippet }
  actionPreview   String?        // JSON object of suggested actionable intent { actionType, title, params, confirmed }
  actionExecuted  Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([conversationId])
  @@index([role])
}

model AIConfiguration {
  id                  String         @id @default(cuid())
  organizationId      String         @unique
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isEnabled           Boolean        @default(true)
  provider            String         @default("INTERNAL") // INTERNAL, GEMINI, OPENAI
  model               String         @default("crm-intelligence-v1")
  apiKey              String?        // Encrypted / masked provider key
  maxTokensPerReq     Int            @default(4096)
  featuresEnabled     String?        // JSON string of feature flags { assistant: true, summarizer: true, advisor: true, actions: true }
  updatedAt           DateTime       @updatedAt

  @@index([organizationId])
}

model AIUsageLog {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature         String         // ASSISTANT, SUMMARY, ADVISOR, SEARCH, ACTION
  model           String
  tokensUsed      Int            @default(0)
  durationMs      Int            @default(0)
  success         Boolean        @default(true)
  errorMessage    String?
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([feature])
  @@index([createdAt])
}

// ==========================================
// 77. ACCOUNTS & DOUBLE-ENTRY LEDGER SYSTEM
// ==========================================

model Account {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String       // e.g. "1010", "1020", "2010", "4010"
  name           String       // e.g. "Cash On Hand", "Operating Bank", "Accounts Receivable"
  type           String       // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  subcategory    String       // CURRENT_ASSET, BANK, FIXED_ASSET, CURRENT_LIABILITY, TAX_PAYABLE, EQUITY, OPERATING_REVENUE, DIRECT_EXPENSE, OPERATING_EXPENSE
  currency       String       @default("INR")
  balance        Float        @default(0.0)
  description    String?
  isSystem       Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  journalLines   JournalLine[]
  bankAccount    BankAccount?

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([type])
  @@index([subcategory])
}

model JournalEntry {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryNumber    String        // e.g. "JRN-2026-0001"
  date           DateTime      @default(now())
  reference      String?       // External ref or invoice/bill #
  sourceType     String        @default("MANUAL") // MANUAL, INVOICE, BILL, PAYMENT, EXPENSE, BANK_TRANSFER, OPENING_BALANCE
  sourceId       String?
  notes          String?
  totalAmount    Float         @default(0.0) // Debit sum = Credit sum
  status         String        @default("POSTED") // DRAFT, POSTED, VOID
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines          JournalLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId])
  @@index([date])
  @@index([sourceType])
  @@index([status])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type           String       // DEBIT, CREDIT
  amount         Float        // Positive absolute amount
  description    String?
  entityType     String?      // CLIENT, VENDOR, EMPLOYEE
  entityId       String?

  @@index([journalEntryId])
  @@index([accountId])
  @@index([type])
}

model BankAccount {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId        String?           @unique
  account          Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountName      String            // e.g. "Main Corporate Current Account"
  bankName         String            // e.g. "HDFC Bank", "ICICI Bank"
  accountNumber    String            // Masked or complete number
  accountType      String            @default("CURRENT") // CURRENT, SAVINGS, CREDIT_CARD, CASH
  currency         String            @default("INR")
  currentBalance   Float             @default(0.0)
  availableBalance Float             @default(0.0)
  ifscOrSwift      String?
  branchName       String?
  isDefault        Boolean           @default(false)
  lastSyncedAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  transactions     BankTransaction[]

  @@index([organizationId])
  @@index([accountType])
}

model BankTransaction {
  id            String      @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  date          DateTime    @default(now())
  type          String      // DEPOSIT, WITHDRAWAL, TRANSFER
  amount        Float
  payeeOrPayer  String?
  reference     String?
  description   String?
  status        String      @default("UNRECONCILED") // UNRECONCILED, RECONCILED, EXCLUDED
  reconciledAt  DateTime?
  createdAt     DateTime    @default(now())

  @@index([bankAccountId])
  @@index([status])
  @@index([date])
}

model Estimate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  estimateNumber String       // e.g. "EST-2026-0001"
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  expiryDate     DateTime
  subtotal       Float        @default(0.0)
  taxAmount      Float        @default(0.0)
  discountAmount Float        @default(0.0)
  total          Float        @default(0.0)
  status         String       @default("SENT") // DRAFT, SENT, ACCEPTED, DECLINED, CONVERTED, EXPIRED
  notes          String?
  terms          String?
  items          String?      // JSON stringified items
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, estimateNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model SalesOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderNumber    String       // e.g. "SO-2026-0001"
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  deliveryDate   DateTime?
  subtotal       Float        @default(0.0)
  taxAmount      Float        @default(0.0)
  total          Float        @default(0.0)
  status         String       @default("CONFIRMED") // DRAFT, CONFIRMED, SHIPPED, INVOICED, CANCELLED
  notes          String?
  items          String?      // JSON stringified items
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model CreditNote {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditNoteNumber String       // e.g. "CN-2026-0001"
  clientId         String
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceId        String?
  date             DateTime     @default(now())
  amount           Float        @default(0.0)
  balance          Float        @default(0.0)
  status           String       @default("OPEN") // OPEN, CLOSED, VOID
  reason           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model VendorCredit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditNumber   String       // e.g. "VC-2026-0001"
  vendorId       String
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  amount         Float        @default(0.0)
  balance        Float        @default(0.0)
  status         String       @default("OPEN") // OPEN, CLOSED, VOID
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, creditNumber])
  @@index([organizationId])
  @@index([vendorId])
  @@index([status])
}

model TaxRate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       // e.g. "GST 18%", "GST 5%", "IGST 18%"
  code           String       // e.g. "GST_18", "GST_5"
  rate           Float        // e.g. 18.0
  type           String       @default("GST") // GST, IGST, CGST, SGST, VAT, CUSTOM
  cgst           Float        @default(0.0)
  sgst           Float        @default(0.0)
  igst           Float        @default(0.0)
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

model AccountingSetting {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYearStart      String       @default("APR-MAR") // APR-MAR or JAN-DEC
  accountingMethod     String       @default("ACCRUAL") // ACCRUAL or CASH
  defaultCurrency      String       @default("INR")
  gstin                String?
  pan                  String?
  legalTradeName       String?
  state                String?
  stateCode            String?
  compositionScheme    Boolean      @default(false)
  reverseChargeEnabled Boolean      @default(false)
  invoicePrefix        String       @default("INV-")
  billPrefix           String       @default("BILL-")
  estimatePrefix       String       @default("EST-")
  journalPrefix        String       @default("JRN-")
  paymentTerms         String       @default("NET_30")
  autoLockPeriod       DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId])
}

// ==========================================
// 86. CANDIDATE PRE-ONBOARDING SUBMISSIONS
// ==========================================

model PreOnboardingSubmission {
  id                      String        @id @default(cuid())
  organizationId          String
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  firstName               String
  lastName                String
  email                   String
  phone                   String?
  dateOfBirth             DateTime?
  aadhaarNumber           String?
  
  gender                  String?
  maritalStatus           String?
  bloodGroup              String?
  currentAddress          String?
  permanentAddress        String?
  city                    String?
  state                   String?
  postalCode              String?
  country                 String?       @default("India")
  
  emergencyContactName    String?
  emergencyContactPhone   String?
  emergencyContactRelation String?
  
  highestDegree           String?
  institution             String?
  
  status                  String        @default("PENDING_REVIEW") // PENDING_REVIEW, ONBOARDED, REJECTED
  createdEmployeeId       String?
  
  notes                   String?
  
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([email])
}












